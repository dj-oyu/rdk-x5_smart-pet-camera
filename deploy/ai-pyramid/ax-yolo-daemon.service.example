[Unit]
Description=YOLO NPU Detection Daemon
# axllm runs as the template instance axllm-serve@<model>.service, so this
# After= does not match it. Order against the real instance (and wait for it
# with ExecStartPre) in a device-local drop-in; see scripts/USAGE.md.
After=network-online.target axllm-serve.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/opt/smart-pet-camera/.env
Environment=LD_LIBRARY_PATH=/soc/lib
Environment=AX_YOLO_DAEMON_SOCKET=/run/ax_yolo_daemon.sock
Environment=AX_YOLO_MODEL_DIR=__MODEL_DIR__
ExecStart=/opt/smart-pet-camera/build/ax_yolo_daemon \
  --model yolo26l
Restart=on-failure
RestartSec=3
WatchdogSec=30
# Explicit because the AX650 image sets DefaultTimeoutStartSec/StopSec=5s.
# Start: covers a drop-in ExecStartPre that waits up to 120s for axllm.
# Stop: leaves time for AX_ENGINE/VDEC deinit; a SIGKILL leaks NPU (CMM) memory.
TimeoutStartSec=150
TimeoutStopSec=30

[Install]
WantedBy=ai-pyramid.target
